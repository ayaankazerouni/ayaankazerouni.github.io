#! /usr/bin/env bash

echo "Compiling CV..."
typst compile documents/CV.typ documents/CV.pdf || exit 1

echo "Building site..."
JEKYLL_ENV=production bundle exec jekyll build -d ../ayaankazerouni.github.io/

echo "Deploying site..."
cd ../ayaankazerouni.github.io
git add --all
git commit -m "Build."
git push -f origin master
cd -
