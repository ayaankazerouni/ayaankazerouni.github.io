---
layout: null
permalink: /blog/feed.xml
---

<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
  <title>Ayaan M. Kazerouni</title>
  <link>{{ site.url }}/blog/</link>
  <description>Posts about computing education</description>
  <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>

  {% assign posts = site.pages
   | where_exp: "p", "p.url contains '/blog/' and p.url != '/blog/' and p.url != page.url"
   | sort: "date" | reverse %}
  {% for post in posts %}
  {% if post.unlisted != true %}
  <item>
    <title>{{ post.title | xml_escape }}</title>
    <link>{{ post.url | absolute_url }}</link>
    <guid>{{ post.url | absolute_url }}</guid>
    <pubDate>{{ post.date | date: "%a, %d %b %Y" }}</pubDate>
    <description>
      {{ post.feed_content | xml_escape }}
    </description>
  </item>
  {% endif %}
  {% endfor %}
</channel>
</rss>
